---
// Cierre "Vení a la casa": foto del estudio y contacto. Va en el inicio y en cada página de merch.
---
<section class="closer s-black" id="contacto" aria-labelledby="closer-h">
  <figure class="closer-photo">
    <img src="/assets/media/cierre-estudio-1200.webp" srcset="/assets/media/cierre-estudio-800.webp 800w, /assets/media/cierre-estudio-1200.webp 1200w, /assets/media/cierre-estudio-1600.webp 1600w" sizes="(max-width: 960px) 100vw, 50vw" alt="Sala de control de un estudio de grabación, con consola, monitores y luz cálida" width="1600" height="1201" loading="lazy" decoding="async">
  </figure>
  <div class="closer-box" data-reveal>
    <h2 class="title" id="closer-h" data-i18n="closer.h">Vení a la casa</h2>
    <ul class="contact">
      <li><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg><a href="https://www.google.com/maps/search/?api=1&amp;query=Av.+Corrientes+3231,+Chacarita,+Buenos+Aires" target="_blank" rel="noopener noreferrer">Av. Corrientes 3231, Chacarita</a></li>
      <li><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><a href="tel:+5491112345678">+54 9 11 1234-5678</a></li>
      <li><svg class="ico" aria-hidden="true"><use href="#i-mail"/></svg><a href="mailto:EstudioKameHouse@gmail.com">EstudioKameHouse@gmail.com</a></li>
      <li><svg class="ico" aria-hidden="true"><use href="#i-ig"/></svg><a href="https://www.instagram.com/estudiokamehouse/" target="_blank" rel="noopener noreferrer">@estudiokamehouse</a></li>
    </ul>
    <a class="btn btn-primary" href="/reservar" data-i18n="cta.reservar">Reservar sesión</a>
  </div>
</section>
